#version 450
// Le réseau entier (`net.rs`, `model.py`) sur une position par groupe de travail : ses lignes de
// régions restent dans la mémoire partagée du groupe d'un bout à l'autre, seuls ses octets d'entrée
// et ses sorties passent par la mémoire. Un seul calcul par lot, autant de groupes que de positions.
//
// Poids rangés entrée × sortie (comme `net.rs`) : chaque fil calcule une sortie `o`, et les fils
// voisins lisent des poids voisins. En tête du tampon des poids, la table de leurs positions
// (`vulkan.rs`, `Weights`).
//
// n1([h_i, a_i, g]) se calcule sans former a_i (la moyenne des voisines) : W_a · a_i est la moyenne
// des W_a · h_j des voisines, calculées une fois par région.

layout(local_size_x = 256) in;

// largeur du réseau (64 ou 128)
layout(constant_id = 0) const uint H = 128u;

const uint R = 48u;          // régions au plus (encode::REGIONS)
const uint NODE = 93u;       // octets par région
const uint NODE4 = 80u;      // ligne d'entrée d'une région, complétée à un multiple de 4
const uint GLOBAL = 820u;    // octets de la partie
const uint KEYS = 608u;
const uint GLOBAL_KEYS = 32u;
const uint KINDS = 9u;
const uint OUT = KEYS + 10u;
const uint THREADS = 256u;
const uint RG = THREADS / H; // groupes de lignes : le fil `t` a la sortie `t % H` des lignes `t / H + RG m`
const uint M = (R + RG - 1u) / RG;
const uint CATN = GLOBAL > 3u * H ? GLOBAL : 3u * H;
const uint MIDN = R * (NODE4 > H ? NODE4 : H);

layout(std430, binding = 0) readonly buffer Weights { float w[]; };
layout(std430, binding = 1) readonly buffer Input { uint inp[]; };
layout(std430, binding = 2) writeonly buffer Output { float outp[]; };

layout(push_constant) uniform Params {
    uint node_off;
    uint glob_off;
    uint adj_off;
    uint regions_off;
    uint layers;
    // les positions du calcul : les places de l'anneau rangées dans la file d'ordre (`order_off`,
    // `ring` numéros), à partir de son numéro `first`
    uint first;
    uint ring;
    uint order_off;
    // ou, si ce n'est pas ~0u, l'étape du flot dont le tampon des étapes donne `first` (`launch`)
    uint step;
    // le réseau de chaque position (un octet par place), et où commencent les poids de chacun (f32,
    // bf16), deux au plus
    uint nets_off;
    uint wbase0, wbbase0, wbase1, wbbase1;
    // les couches du deuxième réseau (`layers` : celles du premier)
    uint layers1;
} p;
layout(std430, binding = 5) readonly buffer Steps { uvec4 steps[]; };

// la table en tête des poids
const uint T_NODE_SCALE = 0u, T_GLOBAL_SCALE = 1u, T_NODE_IN = 2u, T_GLOB_IN = 4u, T_GLOB_POL1 = 6u,
           T_GLOB_POL2 = 8u, T_NODE_POL = 10u, T_VAL1 = 12u, T_VAL2 = 14u, T_LAYERS = 16u;

shared vec4 hs[R * H / 4u];  // lignes des régions, 4 nombres à la fois
shared vec4 mid[MIDN / 4u];  // entrées des régions, puis W_a · h, puis relu(n1(…)), puis node_pol
shared float cat[CATN];      // entrées de la partie, puis [g, moyenne h, max h]
shared float vin[H];         // entrée d'un produit d'un seul vecteur (`gemv`)
shared float vout[H];        // sa sortie
shared float gp[H];          // la part de g dans n1
shared float red[THREADS];   // sommes partielles de `gemv`
shared uvec2 adj[R];
shared float gnp[KINDS];

// les poids du réseau de la position : sa table, puis ses positions décalées d'autant (`main`) ; ce
// shader ne lit que les poids en f32
uint WB;
uint T(uint i) { return floatBitsToUint(w[WB + i]) + WB; }

uint byte_at(uint at) { return (inp[at >> 2] >> ((at & 3u) * 8u)) & 0xffu; }

void sync() {
    memoryBarrierShared();
    barrier();
}

float hs_at(uint e) { return hs[e >> 2][e & 3u]; }
float mid_at(uint e) { return mid[e >> 2][e & 3u]; }
void hs_set(uint e, float v) { hs[e >> 2][e & 3u] = v; }
void mid_set(uint e, float v) { mid[e >> 2][e & 3u] = v; }

// vout[0…n) = act(b + Σ_k x_k W[k][o]), x = cat (from_cat) ou vin, K entrées ; les fils se
// partagent les entrées par groupes, puis additionnent. Huit lectures des poids à la fois, pour
// ne pas attendre chacune.
void gemv(bool from_cat, uint wt, uint bt, uint k, uint n, bool relu) {
    uint t = gl_LocalInvocationID.x, o = t % H, part = t / H;
    uint per = (k + RG - 1u) / RG;
    uint k0 = part * per, k1 = min(k, k0 + per);
    float s = 0.0;
    if (o < n) {
        uint kk = k0;
        for (; kk + 8u <= k1; kk += 8u) {
            float wv[8];
            for (uint q = 0u; q < 8u; q++)
                wv[q] = w[wt + (kk + q) * n + o];
            for (uint q = 0u; q < 8u; q++)
                s = fma(from_cat ? cat[kk + q] : vin[kk + q], wv[q], s);
        }
        for (; kk < k1; kk++)
            s = fma(from_cat ? cat[kk] : vin[kk], w[wt + kk * n + o], s);
    }
    red[t] = s;
    sync();
    if (t < n) {
        float v = w[bt + t];
        for (uint q = 0u; q < RG; q++)
            v += red[q * H + t];
        vout[t] = relu ? max(v, 0.0) : v;
    }
    sync();
}

void main() {
    uint first = p.step == ~0u ? p.first : steps[p.step].w;
    uint pos = inp[(p.order_off >> 2) + (first + gl_WorkGroupID.x) % p.ring];
    bool second = byte_at(p.nets_off + pos) != 0u;
    WB = second ? p.wbase1 : p.wbase0;
    uint t = gl_LocalInvocationID.x, o = t % H, rg = t / H;
    uint r = byte_at(p.regions_off + pos);

    // les entrées
    for (uint i = t; i < R; i += THREADS) {
        uint word = (p.adj_off >> 2) + (pos * R + i) * 2u;
        adj[i] = uvec2(inp[word], inp[word + 1u]);
    }
    uint gs = T(T_GLOBAL_SCALE), ns = T(T_NODE_SCALE);
    for (uint k = t; k < GLOBAL; k += THREADS)
        cat[k] = float(byte_at(p.glob_off + pos * GLOBAL + k)) * w[gs + k];
    for (uint e = t; e < r * NODE4; e += THREADS) {
        uint i = e / NODE4, k = e % NODE4;
        mid_set(e, k < NODE ? float(byte_at(p.node_off + (pos * R + i) * NODE + k)) * w[ns + k] : 0.0);
    }
    sync();

    // g = glob_in(x_g)
    gemv(true, T(T_GLOB_IN), T(T_GLOB_IN + 1u), GLOBAL, H, false);
    if (t < H)
        cat[t] = vout[t];
    // h_i = node_in(x_i)
    {
        uint wt = T(T_NODE_IN), bt = T(T_NODE_IN + 1u);
        float acc[M];
        for (uint m = 0u; m < M; m++)
            acc[m] = 0.0;
        for (uint k = 0u; k < NODE4; k += 4u) {
            vec4 wv = vec4(0.0);
            for (uint q = 0u; q < 4u; q++)
                if (k + q < NODE)
                    wv[q] = w[wt + (k + q) * H + o];
            for (uint m = 0u; m < M; m++) {
                uint i = rg + RG * m;
                if (i < r)
                    acc[m] += dot(mid[(i * NODE4 + k) >> 2], wv);
            }
        }
        float b = w[bt + o];
        for (uint m = 0u; m < M; m++) {
            uint i = rg + RG * m;
            if (i < r)
                hs_set(i * H + o, acc[m] + b);
        }
    }
    sync();

    for (uint l = 0u; l < (second ? p.layers1 : p.layers); l++) {
        uint base = T_LAYERS + 8u * l;
        uint n1w = T(base), n1b = T(base + 1u), n2w = T(base + 2u), n2b = T(base + 3u);
        uint g1w = T(base + 4u), g1b = T(base + 5u), g2w = T(base + 6u), g2b = T(base + 7u);
        // la part de g dans n1, et son biais
        if (t < H)
            vin[t] = cat[t];
        sync();
        gemv(false, n1w + 2u * H * H, n1b, H, H, false);
        if (t < H)
            gp[t] = vout[t];
        // W_h · h_i (gardé) et W_a · h_i (pour les voisines)
        float acc_h[M], acc_a[M];
        for (uint m = 0u; m < M; m++) {
            acc_h[m] = 0.0;
            acc_a[m] = 0.0;
        }
        for (uint k = 0u; k < H; k += 4u) {
            vec4 wh = vec4(w[n1w + k * H + o], w[n1w + (k + 1u) * H + o], w[n1w + (k + 2u) * H + o],
                           w[n1w + (k + 3u) * H + o]);
            uint wa0 = n1w + (H + k) * H + o;
            vec4 wa = vec4(w[wa0], w[wa0 + H], w[wa0 + 2u * H], w[wa0 + 3u * H]);
            for (uint m = 0u; m < M; m++) {
                uint i = rg + RG * m;
                if (i < r) {
                    vec4 x = hs[(i * H + k) >> 2];
                    acc_h[m] += dot(x, wh);
                    acc_a[m] += dot(x, wa);
                }
            }
        }
        for (uint m = 0u; m < M; m++) {
            uint i = rg + RG * m;
            if (i < r)
                mid_set(i * H + o, acc_a[m]);
        }
        sync();
        // n1 : g, h, moyenne des voisines ; relu
        for (uint m = 0u; m < M; m++) {
            uint i = rg + RG * m;
            if (i < r) {
                uvec2 bits = adj[i];
                uint count = bitCount(bits.x) + bitCount(bits.y);
                float s = 0.0;
                for (uint half_ = 0u; half_ < 2u; half_++) {
                    uint b = half_ == 0u ? bits.x : bits.y;
                    while (b != 0u) {
                        uint j = uint(findLSB(b)) + 32u * half_;
                        b &= b - 1u;
                        s += mid_at(j * H + o);
                    }
                }
                acc_h[m] = max(gp[o] + acc_h[m] + s / float(max(count, 1u)), 0.0);
            }
        }
        sync();
        for (uint m = 0u; m < M; m++) {
            uint i = rg + RG * m;
            if (i < r)
                mid_set(i * H + o, acc_h[m]);
        }
        sync();
        // h_i += n2(…)
        for (uint m = 0u; m < M; m++)
            acc_h[m] = 0.0;
        for (uint k = 0u; k < H; k += 4u) {
            vec4 wv = vec4(w[n2w + k * H + o], w[n2w + (k + 1u) * H + o], w[n2w + (k + 2u) * H + o],
                           w[n2w + (k + 3u) * H + o]);
            for (uint m = 0u; m < M; m++) {
                uint i = rg + RG * m;
                if (i < r)
                    acc_h[m] += dot(mid[(i * H + k) >> 2], wv);
            }
        }
        float b2 = w[n2b + o];
        for (uint m = 0u; m < M; m++) {
            uint i = rg + RG * m;
            if (i < r)
                hs_set(i * H + o, hs_at(i * H + o) + acc_h[m] + b2);
        }
        sync();
        // moyenne et maximum des régions, puis g += g2(relu(g1([g, moyenne, max])))
        if (t < H) {
            float s = 0.0, mx = uintBitsToFloat(0xff800000u);
            for (uint i = 0u; i < r; i++) {
                float v = hs_at(i * H + t);
                s += v;
                mx = max(mx, v);
            }
            cat[H + t] = s / float(r);
            cat[2u * H + t] = mx;
        }
        sync();
        gemv(true, g1w, g1b, 3u * H, H, true);
        if (t < H)
            vin[t] = vout[t];
        sync();
        gemv(false, g2w, g2b, H, H, false);
        if (t < H)
            cat[t] += vout[t];
        sync();
    }

    uint out0 = pos * OUT;
    // politique de la partie
    gemv(true, T(T_GLOB_POL1), T(T_GLOB_POL1 + 1u), H, H, true);
    if (t < H)
        vin[t] = vout[t];
    sync();
    gemv(false, T(T_GLOB_POL2), T(T_GLOB_POL2 + 1u), H, GLOBAL_KEYS, false);
    if (t < GLOBAL_KEYS)
        outp[out0 + t] = vout[t];
    // politique des régions : node_pol([h_i, g]), la part de g une fois
    uint npw = T(T_NODE_POL);
    gemv(true, npw + H * KINDS, T(T_NODE_POL + 1u), H, KINDS, false);
    if (t < KINDS)
        gnp[t] = vout[t];
    // ses poids des régions dans `mid`, rangés sorte × entrée
    for (uint e = t; e < H * KINDS; e += THREADS) {
        uint k = e / KINDS, kind = e % KINDS;
        mid_set(kind * H + k, w[npw + e]);
    }
    sync();
    for (uint e = t; e < 64u * KINDS; e += THREADS) {
        uint i = e % 64u, kind = e / 64u;
        float v = uintBitsToFloat(0xff800000u);
        if (i < r) {
            v = gnp[kind];
            for (uint k = 0u; k < H; k += 4u)
                v += dot(hs[(i * H + k) >> 2], mid[(kind * H + k) >> 2]);
        }
        outp[out0 + GLOBAL_KEYS + e] = v;
    }
    // valeur : val2(relu(val1([g, moyenne h]))), la moyenne laissée par le dernier pooling
    gemv(true, T(T_VAL1), T(T_VAL1 + 1u), 2u * H, H, true);
    if (t < H)
        vin[t] = vout[t];
    sync();
    gemv(false, T(T_VAL2), T(T_VAL2 + 1u), H, 10u, false);
    if (t < 10u)
        outp[out0 + KEYS + t] = vout[t];
}
