#version 450
// Les sorties d'une position gardées dans la mémoire du GPU, à sa place (octets 2 et 3 après le nombre
// de régions dans les entrées) : comme `pack`, et les jetons présents et le nombre de régions
// (`slot_info`) ; les 20 têtes vont à l'hôte (`outf`).
#include "common.glsl"
#include "slots.glsl"

layout(local_size_x = 256) in;

layout(push_constant) uniform Params {
    uint x_off, reg_off, kv_off, v2_off, n2_off, d, dec, per16;
} p;

void main() {
    uint pos = gl_WorkGroupID.x;
    uint t = gl_LocalInvocationID.x;
    uint d = p.d;
    uint slot = byte_at(pos, IN_REGIONS + 2u) | (byte_at(pos, IN_REGIONS + 3u) << 8u);
    uint base = slot * p.per16;
    for (uint idx = t; idx < R * d; idx += 256u) {
        uint i = idx / d, c = idx % d;
        slot16[base + idx] = bfloat16_t(act[p.x_off + (pos * TOKENS + i) * d + c]);
        slot16[base + R * d + idx] = bfloat16_t(act[p.reg_off + (pos * R + i) * d + c]);
    }
    uint kvw = 2u * p.dec * d;
    for (uint idx = t; idx < TOKENS * kvw; idx += 256u) {
        uint tok = idx / kvw, c = idx % kvw;
        uint which = c / d, cc = c % d;
        slot16[base + 2u * R * d + (which * TOKENS + tok) * d + cc] = bfloat16_t(act[p.kv_off + (pos * TOKENS + tok) * kvw + c]);
    }
    if (t == 0u) slot_info[slot * INFO] = regions_of(pos);
    if (t < TOKENS) slot_info[slot * INFO + 1u + t] = token_valid(pos, t) ? 1u : 0u;
    if (t < 10u) outf[pos * 20u + t] = act[p.v2_off + pos * 16u + t];
    else if (t < 20u) outf[pos * 20u + t] = act[p.n2_off + pos * 16u + t - 10u];
}
